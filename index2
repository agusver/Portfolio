            <span class="r-num">↑</span>
            <span class="r-label">Interés de RRHH en escalar el sistema a toda la empresa</span>
          </div>
        </div>
      </div>
    </div>

    <!-- CASO 6: VALIDADOR DOCUMENTACIÓN 0KM -->
    <div class="case-card" id="case6">
      <div class="case-header" onclick="toggleCase('case6')">
