<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Portfolio — Mejora Continua</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --ink: #0f0f0f;
    --paper: #f5f2ec;
    --accent: #c8502a;
    --accent2: #2a6b8a;
    --muted: #8a8278;
    --card: #ffffff;
    --border: #ddd8d0;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--paper);
    color: var(--ink);
    font-family: 'DM Sans', sans-serif;
    font-weight: 300;
    line-height: 1.7;
  }

  /* HEADER */
  .hero {
    background: var(--ink);
    color: var(--paper);
    padding: 80px 60px 60px;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    top: -60px; right: -60px;
    width: 400px; height: 400px;
    border-radius: 50%;
    border: 1px solid rgba(200,80,42,0.3);
  }
  .hero::after {
    content: '';
    position: absolute;
    bottom: -80px; left: 40%;
    width: 200px; height: 200px;
    border-radius: 50%;
    border: 1px solid rgba(200,80,42,0.15);
  }
  .hero-tag {
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 20px;
  }
  .hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(36px, 6vw, 72px);
    font-weight: 900;
    line-height: 1.05;
    max-width: 700px;
    margin-bottom: 24px;
  }
  .hero p {
    font-size: 16px;
    color: rgba(245,242,236,0.65);
    max-width: 520px;
    line-height: 1.8;
  }
  .hero-meta {
    margin-top: 48px;
    display: flex;
    gap: 40px;
    flex-wrap: wrap;
  }
  .hero-stat {
    border-left: 2px solid var(--accent);
    padding-left: 16px;
  }
  .hero-stat .num {
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    font-weight: 700;
    color: var(--paper);
  }
  .hero-stat .label {
    font-size: 12px;
    color: rgba(245,242,236,0.5);
    letter-spacing: 1px;
  }

  /* SECCIÓN */
  .section {
    max-width: 960px;
    margin: 0 auto;
    padding: 80px 40px;
  }
  .section-label {
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 12px;
  }
  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: 36px;
    font-weight: 700;
    margin-bottom: 48px;
    color: var(--ink);
  }

  /* METODOLOGÍA */
  .method-block {
    background: var(--ink);
    color: var(--paper);
    padding: 48px;
    border-radius: 2px;
    margin-bottom: 24px;
  }
  .method-block p {
    font-size: 16px;
    line-height: 1.9;
    color: rgba(245,242,236,0.8);
  }
  .method-block strong {
    color: var(--accent);
    font-weight: 500;
  }

  /* CASOS */
  .cases-grid {
    display: grid;
    gap: 2px;
  }

  .case-card {
    background: var(--card);
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .case-header {
    padding: 40px 48px 32px;
    cursor: pointer;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 24px;
    align-items: start;
    transition: background 0.2s;
  }
  .case-header:hover { background: #fafaf8; }

  .case-number {
    font-family: 'Playfair Display', serif;
    font-size: 48px;
    font-weight: 900;
    color: var(--border);
    line-height: 1;
    user-select: none;
  }

  .case-meta h3 {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 8px;
    line-height: 1.3;
  }
  .case-meta .quick-summary {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.7;
    max-width: 560px;
  }
  .case-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }
  .tag {
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 4px 10px;
    border: 1px solid var(--border);
    color: var(--muted);
    border-radius: 2px;
  }
  .tag.accent { border-color: var(--accent); color: var(--accent); }
  .tag.accent2 { border-color: var(--accent2); color: var(--accent2); }

  .case-toggle {
    font-size: 22px;
    color: var(--muted);
    user-select: none;
    transition: transform 0.3s;
    padding-top: 4px;
  }
  .case-card.open .case-toggle { transform: rotate(45deg); }

  /* DETALLE */
  .case-detail {
    display: none;
    border-top: 1px solid var(--border);
    padding: 48px;
    background: #fdfcfa;
  }
  .case-card.open .case-detail { display: block; }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-bottom: 40px;
  }
  @media (max-width: 640px) { .detail-grid { grid-template-columns: 1fr; } }

  .detail-block h4 {
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 12px;
  }
  .detail-block p, .detail-block li {
    font-size: 14px;
    line-height: 1.8;
    color: #3a3530;
  }
  .detail-block ul {
    list-style: none;
    padding: 0;
  }
  .detail-block ul li::before {
    content: '→ ';
    color: var(--accent);
    font-size: 12px;
  }

  .quote-block {
    border-left: 3px solid var(--accent);
    padding: 20px 28px;
    margin: 32px 0;
    background: rgba(200,80,42,0.04);
  }
  .quote-block p {
    font-family: 'Playfair Display', serif;
    font-size: 17px;
    font-style: italic;
    line-height: 1.7;
    color: var(--ink);
  }

  .result-row {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    margin-top: 32px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
  .result-item {
    flex: 1;
    min-width: 140px;
    padding: 20px;
    background: var(--ink);
    color: var(--paper);
  }
  .result-item .r-num {
    font-family: 'Playfair Display', serif;
    font-size: 28px;
    font-weight: 700;
    color: var(--accent);
    display: block;
    margin-bottom: 4px;
  }
  .result-item .r-label {
    font-size: 12px;
    color: rgba(245,242,236,0.6);
    line-height: 1.5;
  }

  .in-progress-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--accent2);
    border: 1px solid var(--accent2);
    padding: 4px 12px;
    border-radius: 2px;
    margin-bottom: 20px;
  }
  .in-progress-badge::before {
    content: '';
    width: 6px; height: 6px;
    background: var(--accent2);
    border-radius: 50%;
    animation: pulse 1.5s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  /* DIVIDER */
  .divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 0 40px;
  }

  /* FOOTER */
  footer {
    background: var(--ink);
    color: rgba(245,242,236,0.4);
    text-align: center;
    padding: 40px;
    font-size: 12px;
    letter-spacing: 1px;
  }

  /* ANIMACIÓN entrada */
  .case-card {
    opacity: 0;
    transform: translateY(16px);
    animation: fadeUp 0.5s forwards;
  }
  .case-card:nth-child(1) { animation-delay: 0.1s; }
  .case-card:nth-child(2) { animation-delay: 0.2s; }
  .case-card:nth-child(3) { animation-delay: 0.3s; }
  .case-card:nth-child(4) { animation-delay: 0.4s; }
  .case-card:nth-child(5) { animation-delay: 0.5s; }
  .case-card:nth-child(6) { animation-delay: 0.6s; }
  .case-card:nth-child(7) { animation-delay: 0.7s; }
  @keyframes fadeUp {
    to { opacity: 1; transform: translateY(0); }
  }
  .case-card.open {
    opacity: 1;
    transform: translateY(0);
    animation: none;
  }
</style>
</head>
